
if [[ -n $SSH_CONNECTION && -z $ZELLIJ ]]; then
  exec zellij attach --create alef
fi

# VARIABLES
for file in ~/.zshrc.d/vars/*; do
  source "$file"
done


autoload -Uz compinit && compinit

setopt autocd
setopt interactivecomments

setopt incappendhistory
setopt histignorealldups
setopt extendedhistory
HISTFILE=~/.histfile
HISTSIZE=60000
SAVEHIST=60000

autoload -U promptinit && promptinit
autoload -U +X bashcompinit && bashcompinit

# setopt promptsubst

if [[ $TERM == linux ]]; then
  local sep1='>' sep2='>'
else
  local sep1=$'\U300B' sep2=$'\U2771'
fi
PROMPT="%F{green}%(#.%K{red}%m%k.%m)%f%B%F{cyan}${sep1} %f%b%F{yellow}%(4~.…/%3~.%~)%f%B%F{cyan}${sep2} %f%b"

# add \n between prompts/outputs
breathingroom () { print '' }
add-zsh-hook precmd breathingroom


source /usr/share/fzf/key-bindings.zsh
source /usr/share/fzf/completion.zsh


# ALII (ALIASES)
for file in ~/.zshrc.d/alii/*; do
  source "$file"
done

# FUNCTIONS
for file in ~/.zshrc.d/functions/*; do
  source "$file"
done

# KEY STUFF
for file in ~/.zshrc.d/keys/*; do
  source "$file"
done

# TOOLS
for file in ~/.zshrc.d/tools/*; do
  source "$file"
done

# COMPLETIONS
for file in ~/.zshrc.d/completions/*; do
  source "$file"
done


# dbus-update-activation-environment --systemd --all



# zsh-highlighting wants to be sourced last
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


